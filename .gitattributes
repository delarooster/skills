# Force LF line endings regardless of platform/core.autocrlf. Without this,
# Git for Windows (core.autocrlf=true by default) rewrites shell scripts to
# CRLF on checkout, which breaks the shebang line (#!/usr/bin/env bash\r).
* text=auto eol=lf

*.sh text eol=lf

# Binary assets: never touch line endings or attempt text diffs.
*.pptx binary
